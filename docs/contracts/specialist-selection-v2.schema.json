{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aies.local/contracts/specialist-selection-v2.schema.json",
  "title": "AIES proposed specialist selection v2 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "workflowId", "taskId", "requiredCompetencies", "maxCostUnits", "permittedTools"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflowId": {"type": "string", "minLength": 1, "maxLength": 128},
    "taskId": {"type": "string", "minLength": 1, "maxLength": 128},
    "requiredCompetencies": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "policyRef": {"type": "string", "minLength": 3},
    "maxCostUnits": {"type": "integer", "minimum": 0, "maximum": 100000},
    "permittedTools": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
